# LONE LINK — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# WebSocket server URL for Internet transport
WEBSOCKET_URL=ws://localhost:8080/ws

# Server authentication token (if required)
# SERVER_AUTH_TOKEN=your_token_here

# Enable debug logging (true/false)
DEBUG_LOGGING=true

# BLE scan duration in seconds
BLE_SCAN_DURATION=10

# Default message TTL (max hops)
MESSAGE_TTL=8

# Message expiry in hours
MESSAGE_EXPIRY_HOURS=24
